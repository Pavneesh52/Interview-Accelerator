# App
APP_NAME="Interview Agent API"
APP_VERSION="0.1.0"
DEBUG=true
API_V1_STR="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/interview_agent"

# Redis
REDIS_URL="redis://localhost:6379/0"

# JWT
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# File Storage (S3/MinIO)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="interview-agent"
S3_REGION="us-east-1"

# LLM Providers
# NVIDIA Nemotron (self-hosted or API)
NEMOTRON_API_BASE="http://localhost:8001/v1"
NEMOTRON_API_KEY=""
NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b"

# OpenAI (fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic (fallback)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Google Gemini (fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "text/plain"]